# Server Configuration
PORT=3000

# AI Configuration (Google Gemini API)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# TextBee SMS Gateway (FREE) — https://textbee.dev
# ============================================================
# Step 1: Register at https://app.textbee.dev/register
# Step 2: Install TextBee app on your Android phone
# Step 3: Copy your API Key & Device ID from the dashboard
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_textbee_device_id_here
